{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Minimal review aligned semantics v2; no new output fields",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "issue_reviews": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/review"
      }
    },
    "new_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "related_issue_handle": {
            "type": [
              "string",
              "null"
            ]
          },
          "check": {
            "$ref": "#/$defs/check"
          }
        },
        "required": [
          "related_issue_handle",
          "check"
        ]
      }
    }
  },
  "required": [
    "issue_reviews",
    "new_findings"
  ],
  "$defs": {
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "original_case_reviews": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "case_handle": {
                "type": "string"
              },
              "observed_value": {
                "type": "string",
                "description": "Fresh observed value for the original object/version. Do not merely copy history. Put calculation in reason."
              },
              "original_assessment": {
                "enum": [
                  "supported",
                  "refuted",
                  "uncertain"
                ],
                "description": "Assesses the original recorded observation only. supported=independent recomputation confirms old_observed_value; refuted=recomputation shows the old observation wrong. A counterexample refuting the OLD CANDIDATE normally SUPPORTS the original audit observation."
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "case_handle",
              "observed_value",
              "original_assessment",
              "reason"
            ]
          }
        },
        "current_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "resolution": {
          "enum": [
            "same_object_repaired",
            "replaced",
            "rebutted",
            "unresolved"
          ]
        },
        "dependency": {
          "enum": [
            "still_used",
            "removed",
            "not_applicable",
            "unknown"
          ]
        },
        "verdict": {
          "enum": [
            "resolved",
            "unresolved",
            "defect"
          ]
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "original_case_reviews",
        "current_checks",
        "resolution",
        "dependency",
        "verdict",
        "reason"
      ]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target_handle": {
          "type": "string"
        },
        "input": {
          "type": "string"
        },
        "quantity": {
          "type": "string"
        },
        "expected_value": {
          "type": "string",
          "description": "For exact_equality return only a canonical integer or reduced rational, such as 0 or -3/2. No equation, units, prose, decimal or calculation; put derivation in reason."
        },
        "observed_value": {
          "type": "string",
          "description": "For exact_equality return only a canonical integer or reduced rational, such as 0 or -3/2. No equation, units, prose, decimal or calculation; put derivation in reason."
        },
        "reason": {
          "type": "string"
        },
        "task_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "comparison_kind": {
          "enum": [
            "exact_equality",
            "model_judged"
          ],
          "description": "exact_equality only for equality between the same semantic scalar quantity with integer/rational values. Nonzero, integrality, ordered pairs and qualitative assertions use model_judged."
        },
        "outcome": {
          "enum": [
            "match",
            "counterexample",
            "uncertain"
          ],
          "description": "counterexample refutes the CURRENT target claim, never merely a discarded old answer. A valid rejection of an old answer is not a counterexample to the current candidate."
        }
      },
      "required": [
        "target_handle",
        "input",
        "quantity",
        "expected_value",
        "observed_value",
        "reason",
        "task_refs",
        "comparison_kind",
        "outcome"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "comparison_kind": {
                "const": "exact_equality"
              }
            },
            "required": [
              "comparison_kind"
            ]
          },
          "then": {
            "properties": {
              "expected_value": {
                "pattern": "^-?(?:0|[1-9][0-9]*)(?:/[1-9][0-9]*)?$"
              },
              "observed_value": {
                "pattern": "^-?(?:0|[1-9][0-9]*)(?:/[1-9][0-9]*)?$"
              }
            }
          }
        }
      ]
    }
  }
}