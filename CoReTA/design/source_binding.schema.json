{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/coreta/design/0.7-source-binding/schema.json",
  "title": "CoReTA source-bound facts and declared-item coverage",
  "$ref": "#/$defs/Event",
  "$defs": {
    "PublicTask": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "maxLength": 100
        },
        "task_type": {
          "type": "string",
          "enum": [
            "math",
            "code"
          ]
        },
        "prompt": {
          "type": "string",
          "maxLength": 20000
        },
        "entry_point": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "task_id",
        "task_type",
        "prompt",
        "entry_point"
      ],
      "additionalProperties": false
    },
    "Step": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^s[1-8]$"
        },
        "text": {
          "type": "string",
          "maxLength": 1600
        },
        "basis_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 120
          },
          "maxItems": 8
        },
        "status": {
          "type": "string",
          "enum": [
            "candidate",
            "supported",
            "disputed",
            "unresolved"
          ]
        }
      },
      "required": [
        "id",
        "text",
        "basis_refs",
        "status"
      ],
      "additionalProperties": false
    },
    "Candidate": {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "string",
          "maxLength": 16000
        },
        "summary": {
          "type": "string",
          "maxLength": 1200
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Step"
          },
          "maxItems": 6
        },
        "open_issues": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 800
          },
          "maxItems": 3
        }
      },
      "required": [
        "artifact",
        "summary",
        "steps",
        "open_issues"
      ],
      "additionalProperties": false
    },
    "HelpRequest": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "complete",
            "verify",
            "alternative"
          ]
        },
        "goal": {
          "type": "string",
          "maxLength": 1000
        },
        "target_step_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20
          },
          "maxItems": 8
        },
        "current_attempt": {
          "type": "string",
          "maxLength": 1600
        },
        "deliverable": {
          "type": "string",
          "maxLength": 1000
        },
        "check_plan": {
          "type": "string",
          "maxLength": 1000
        },
        "reason_for_recipient": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "required": [
        "kind",
        "goal",
        "target_step_ids",
        "current_attempt",
        "deliverable",
        "check_plan",
        "reason_for_recipient"
      ],
      "additionalProperties": false
    },
    "Decision": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "CONTINUE_SELF",
            "REQUEST_HELP",
            "REQUEST_CHECK",
            "REQUEST_ALTERNATIVE",
            "FINISH"
          ]
        },
        "recipient": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "A0",
                "A1",
                "A2"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "request": {
          "anyOf": [
            {
              "$ref": "#/$defs/HelpRequest"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "required": [
        "action",
        "recipient",
        "request",
        "reason"
      ],
      "additionalProperties": false
    },
    "Contribution": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "maxLength": 120
        },
        "status": {
          "type": "string",
          "enum": [
            "provided",
            "cannot_help"
          ]
        },
        "body": {
          "type": "string",
          "maxLength": 10000
        },
        "basis_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 120
          },
          "maxItems": 8
        },
        "check_suggestion": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "required": [
        "request_id",
        "status",
        "body",
        "basis_refs",
        "check_suggestion"
      ],
      "additionalProperties": false
    },
    "Finding": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "maxLength": 300
        },
        "claim": {
          "type": "string",
          "maxLength": 1000
        },
        "reason": {
          "type": "string",
          "maxLength": 1600
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 120
          },
          "maxItems": 8
        }
      },
      "required": [
        "scope",
        "claim",
        "reason",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "Review": {
      "type": "object",
      "properties": {
        "subject_id": {
          "type": "string",
          "maxLength": 120
        },
        "verdict": {
          "type": "string",
          "enum": [
            "supported",
            "defect",
            "unresolved"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "maxItems": 3
        },
        "scope_limit": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "required": [
        "subject_id",
        "verdict",
        "findings",
        "scope_limit"
      ],
      "additionalProperties": false
    },
    "Application": {
      "type": "object",
      "properties": {
        "request_id": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "contribution_id": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "review_id": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "disposition": {
          "type": "string",
          "enum": [
            "accepted",
            "rejected",
            "deferred"
          ]
        },
        "before_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 120
          },
          "maxItems": 8
        },
        "changed_step_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20
          },
          "maxItems": 8
        },
        "application_outcome": {
          "type": "string",
          "enum": [
            "resolved",
            "unresolved",
            "regressed",
            "unknown"
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 1600
        }
      },
      "required": [
        "request_id",
        "contribution_id",
        "review_id",
        "disposition",
        "before_refs",
        "changed_step_ids",
        "application_outcome",
        "reason"
      ],
      "additionalProperties": false
    },
    "LeadUpdate": {
      "type": "object",
      "properties": {
        "candidate": {
          "$ref": "#/$defs/Candidate"
        },
        "application": {
          "anyOf": [
            {
              "$ref": "#/$defs/Application"
            },
            {
              "type": "null"
            }
          ]
        },
        "next": {
          "$ref": "#/$defs/Decision"
        }
      },
      "required": [
        "candidate",
        "application",
        "next"
      ],
      "additionalProperties": false
    },
    "Final": {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "string",
          "maxLength": 16000
        },
        "basis_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 120
          },
          "maxItems": 20
        }
      },
      "required": [
        "artifact",
        "basis_refs"
      ],
      "additionalProperties": false
    },
    "RuntimeError": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "MODEL_TIMEOUT",
            "MODEL_UNAVAILABLE",
            "INVALID_JSON",
            "SCHEMA_ERROR",
            "REFERENCE_ERROR",
            "STALE_VERSION",
            "CONTEXT_OVERFLOW",
            "CALL_LIMIT",
            "INVALID_ACTION"
          ]
        },
        "detail": {
          "type": "string",
          "maxLength": 2000
        },
        "failed_event_id": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "detail",
        "failed_event_id"
      ],
      "additionalProperties": false
    },
    "Event": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "schema_version": {
          "const": "coreta/0.7-source-binding"
        },
        "sent_from": {
          "type": "string",
          "enum": [
            "A0",
            "A1",
            "A2"
          ]
        },
        "base_version": {
          "type": "integer"
        },
        "stage": {
          "type": "string",
          "enum": [
            "draft",
            "refine_draft",
            "synthesize",
            "build",
            "inspect",
            "apply",
            "request",
            "work",
            "final",
            "task_facts"
          ]
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "payload": {
          "anyOf": [
            {
              "$ref": "#/$defs/Candidate"
            },
            {
              "$ref": "#/$defs/Synthesis"
            },
            {
              "$ref": "#/$defs/Constructive"
            },
            {
              "$ref": "#/$defs/Inspection"
            },
            {
              "$ref": "#/$defs/RevisionUpdate"
            },
            {
              "$ref": "#/$defs/RevisionDecision"
            },
            {
              "$ref": "#/$defs/Final"
            },
            {
              "$ref": "#/$defs/ClosureUpdate"
            },
            {
              "$ref": "#/$defs/ClosureInspection"
            },
            {
              "$ref": "#/$defs/TaskFacts"
            },
            {
              "$ref": "#/$defs/BoundTaskFacts"
            }
          ]
        }
      },
      "required": [
        "event_id",
        "schema_version",
        "sent_from",
        "base_version",
        "stage",
        "task_id",
        "payload"
      ],
      "additionalProperties": false
    },
    "Synthesis": {
      "type": "object",
      "properties": {
        "candidate": {
          "$ref": "#/$defs/Candidate"
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 3000
              },
              "blocking": {
                "type": "boolean"
              },
              "target_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "maxItems": 12
              },
              "existing_issue_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 30
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "acceptance_condition": {
                "type": "string",
                "minLength": 1,
                "maxLength": 3000
              }
            },
            "required": [
              "description",
              "blocking",
              "target_refs",
              "existing_issue_id",
              "acceptance_condition"
            ],
            "additionalProperties": false
          },
          "maxItems": 6
        }
      },
      "required": [
        "candidate",
        "issues"
      ],
      "additionalProperties": false
    },
    "Constructive": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "provided",
            "cannot_help"
          ]
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        },
        "basis_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "maxItems": 12
        },
        "attempted_issue_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "maxItems": 6
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 3000
              },
              "blocking": {
                "type": "boolean"
              },
              "target_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "maxItems": 12
              },
              "existing_issue_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 30
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "acceptance_condition": {
                "type": "string",
                "minLength": 1,
                "maxLength": 3000
              }
            },
            "required": [
              "description",
              "blocking",
              "target_refs",
              "existing_issue_id",
              "acceptance_condition"
            ],
            "additionalProperties": false
          },
          "maxItems": 6
        }
      },
      "required": [
        "status",
        "body",
        "basis_refs",
        "attempted_issue_ids",
        "issues"
      ],
      "additionalProperties": false
    },
    "Inspection": {
      "type": "object",
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "target_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "maxItems": 12
              },
              "method": {
                "type": "string",
                "minLength": 1,
                "maxLength": 3000
              },
              "observation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 3000
              },
              "conclusion": {
                "type": "string",
                "enum": [
                  "supported",
                  "defect",
                  "unresolved"
                ]
              },
              "scope": {
                "type": "string",
                "minLength": 1,
                "maxLength": 3000
              }
            },
            "required": [
              "target_refs",
              "method",
              "observation",
              "conclusion",
              "scope"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 6
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 3000
              },
              "blocking": {
                "type": "boolean"
              },
              "target_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "maxItems": 12
              },
              "existing_issue_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 30
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "acceptance_condition": {
                "type": "string",
                "minLength": 1,
                "maxLength": 3000
              }
            },
            "required": [
              "description",
              "blocking",
              "target_refs",
              "existing_issue_id",
              "acceptance_condition"
            ],
            "additionalProperties": false
          },
          "maxItems": 6
        }
      },
      "required": [
        "checks",
        "issues"
      ],
      "additionalProperties": false
    },
    "RevisionUpdate": {
      "type": "object",
      "properties": {
        "candidate": {
          "$ref": "#/$defs/Candidate"
        },
        "resolutions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "issue_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 30
              },
              "status": {
                "type": "string",
                "enum": [
                  "open",
                  "addressed",
                  "dismissed"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 3000
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "maxItems": 12
              },
              "changed_step_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 3
                },
                "maxItems": 8
              }
            },
            "required": [
              "issue_id",
              "status",
              "reason",
              "evidence_refs",
              "changed_step_ids"
            ],
            "additionalProperties": false
          },
          "maxItems": 40
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 3000
              },
              "blocking": {
                "type": "boolean"
              },
              "target_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "maxItems": 12
              },
              "existing_issue_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 30
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "description",
              "blocking",
              "target_refs",
              "existing_issue_id"
            ],
            "additionalProperties": false
          },
          "maxItems": 6
        },
        "application": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "next": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "REQUEST_HELP",
                "REQUEST_ALTERNATIVE",
                "REQUEST_CHECK",
                "CONTINUE_SELF",
                "FINISH_COMPLETE",
                "FINISH_STALLED"
              ]
            },
            "recipient": {
              "type": "string",
              "enum": [
                "A0",
                "A1",
                "A2",
                "none"
              ]
            },
            "goal": {
              "type": "string",
              "minLength": 1,
              "maxLength": 3000
            },
            "deliverable": {
              "type": "string",
              "minLength": 1,
              "maxLength": 3000
            },
            "check_plan": {
              "type": "string",
              "minLength": 1,
              "maxLength": 3000
            },
            "issue_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 30
              },
              "maxItems": 6
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 3000
            }
          },
          "required": [
            "action",
            "recipient",
            "goal",
            "deliverable",
            "check_plan",
            "issue_ids",
            "reason"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "candidate",
        "resolutions",
        "issues",
        "application",
        "next"
      ],
      "additionalProperties": false
    },
    "RevisionDecision": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "REQUEST_HELP",
            "REQUEST_ALTERNATIVE",
            "REQUEST_CHECK",
            "CONTINUE_SELF",
            "FINISH_COMPLETE",
            "FINISH_STALLED"
          ]
        },
        "recipient": {
          "type": "string",
          "enum": [
            "A0",
            "A1",
            "A2",
            "none"
          ]
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "deliverable": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "check_plan": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "issue_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "maxItems": 6
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        }
      },
      "required": [
        "action",
        "recipient",
        "goal",
        "deliverable",
        "check_plan",
        "issue_ids",
        "reason"
      ],
      "additionalProperties": false
    },
    "ClosureUpdate": {
      "type": "object",
      "properties": {
        "candidate": {
          "$ref": "#/$defs/Candidate"
        },
        "closure_proposals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "issue_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 30
              },
              "response_to_objection_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                "maxItems": 40
              },
              "disposition": {
                "type": "string",
                "enum": [
                  "addressed",
                  "dismissed"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 3000
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "maxItems": 12
