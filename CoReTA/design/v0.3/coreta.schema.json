{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/coreta/design/0.3/schema.json",
  "title": "CoReTA 0.3 design contract",
  "$ref": "#/$defs/Event",
  "$defs": {
    "PublicTask": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "maxLength": 100
        },
        "task_type": {
          "type": "string",
          "enum": [
            "math",
            "code"
          ]
        },
        "prompt": {
          "type": "string",
          "maxLength": 20000
        },
        "entry_point": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "task_id",
        "task_type",
        "prompt",
        "entry_point"
      ],
      "additionalProperties": false
    },
    "Step": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^s[1-8]$"
        },
        "text": {
          "type": "string",
          "maxLength": 1600
        },
        "basis_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 120
          },
          "maxItems": 8
        },
        "status": {
          "type": "string",
          "enum": [
            "candidate",
            "supported",
            "disputed",
            "unresolved"
          ]
        }
      },
      "required": [
        "id",
        "text",
        "basis_refs",
        "status"
      ],
      "additionalProperties": false
    },
    "Candidate": {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "string",
          "maxLength": 16000
        },
        "summary": {
          "type": "string",
          "maxLength": 1200
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Step"
          },
          "maxItems": 8
        },
        "open_issues": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 800
          },
          "maxItems": 3
        }
      },
      "required": [
        "artifact",
        "summary",
        "steps",
        "open_issues"
      ],
      "additionalProperties": false
    },
    "HelpRequest": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "complete",
            "verify",
            "alternative"
          ]
        },
        "goal": {
          "type": "string",
          "maxLength": 1000
        },
        "target_step_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20
          },
          "maxItems": 8
        },
        "current_attempt": {
          "type": "string",
          "maxLength": 1600
        },
        "deliverable": {
          "type": "string",
          "maxLength": 1000
        },
        "check_plan": {
          "type": "string",
          "maxLength": 1000
        },
        "reason_for_recipient": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "required": [
        "kind",
        "goal",
        "target_step_ids",
        "current_attempt",
        "deliverable",
        "check_plan",
        "reason_for_recipient"
      ],
      "additionalProperties": false
    },
    "Decision": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "CONTINUE_SELF",
            "REQUEST_HELP",
            "REQUEST_CHECK",
            "REQUEST_ALTERNATIVE",
            "FINISH"
          ]
        },
        "recipient": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "A0",
                "A1",
                "A2"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "request": {
          "anyOf": [
            {
              "$ref": "#/$defs/HelpRequest"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "required": [
        "action",
        "recipient",
        "request",
        "reason"
      ],
      "additionalProperties": false
    },
    "Contribution": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "maxLength": 120
        },
        "status": {
          "type": "string",
          "enum": [
            "provided",
            "cannot_help"
          ]
        },
        "body": {
          "type": "string",
          "maxLength": 10000
        },
        "basis_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 120
          },
          "maxItems": 8
        },
        "check_suggestion": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "required": [
        "request_id",
        "status",
        "body",
        "basis_refs",
        "check_suggestion"
      ],
      "additionalProperties": false
    },
    "Finding": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "maxLength": 300
        },
        "claim": {
          "type": "string",
          "maxLength": 1000
        },
        "reason": {
          "type": "string",
          "maxLength": 1600
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 120
          },
          "maxItems": 8
        }
      },
      "required": [
        "scope",
        "claim",
        "reason",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "Review": {
      "type": "object",
      "properties": {
        "subject_id": {
          "type": "string",
          "maxLength": 120
        },
        "verdict": {
          "type": "string",
          "enum": [
            "supported",
            "defect",
            "unresolved"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "maxItems": 3
        },
        "scope_limit": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "required": [
        "subject_id",
        "verdict",
        "findings",
        "scope_limit"
      ],
      "additionalProperties": false
    },
    "Application": {
      "type": "object",
      "properties": {
        "request_id": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "contribution_id": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "review_id": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "disposition": {
          "type": "string",
          "enum": [
            "accepted",
            "rejected",
            "deferred"
          ]
        },
        "before_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 120
          },
          "maxItems": 8
        },
        "changed_step_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20
          },
          "maxItems": 8
        },
        "application_outcome": {
          "type": "string",
          "enum": [
            "resolved",
            "unresolved",
            "regressed",
            "unknown"
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 1600
        }
      },
      "required": [
        "request_id",
        "contribution_id",
        "review_id",
        "disposition",
        "before_refs",
        "changed_step_ids",
        "application_outcome",
        "reason"
      ],
      "additionalProperties": false
    },
    "LeadUpdate": {
      "type": "object",
      "properties": {
        "candidate": {
          "$ref": "#/$defs/Candidate"
        },
        "application": {
          "anyOf": [
            {
              "$ref": "#/$defs/Application"
            },
            {
              "type": "null"
            }
          ]
        },
        "next": {
          "$ref": "#/$defs/Decision"
        }
      },
      "required": [
        "candidate",
        "application",
        "next"
      ],
      "additionalProperties": false
    },
    "Final": {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "string",
          "maxLength": 16000
        },
        "basis_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 120
          },
          "maxItems": 20
        }
      },
      "required": [
        "artifact",
        "basis_refs"
      ],
      "additionalProperties": false
    },
    "RuntimeError": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "MODEL_TIMEOUT",
            "MODEL_UNAVAILABLE",
            "INVALID_JSON",
            "SCHEMA_ERROR",
            "REFERENCE_ERROR",
            "STALE_VERSION",
            "CONTEXT_OVERFLOW",
            "CALL_LIMIT",
            "INVALID_ACTION"
          ]
        },
        "detail": {
          "type": "string",
          "maxLength": 2000
        },
        "failed_event_id": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "detail",
        "failed_event_id"
      ],
      "additionalProperties": false
    },
    "Event": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "coreta/0.3"
        },
        "run_id": {
          "type": "string",
          "maxLength": 120
        },
        "task_id": {
          "type": "string",
          "maxLength": 100
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "event_id": {
          "type": "string",
          "maxLength": 120
        },
        "kind": {
          "type": "string",
          "enum": [
            "draft",
            "request",
            "contribution",
            "review",
            "lead_update",
            "final",
            "runtime_error"
          ]
        },
        "sent_from": {
          "type": "string",
          "enum": [
            "A0",
            "A1",
            "A2",
            "runtime"
          ]
        },
        "send_to": {
          "type": "string",
          "enum": [
            "A0",
            "A1",
            "A2",
            "runtime",
            "archive"
          ]
        },
        "cause_by": {
          "type": "string",
          "maxLength": 100
        },
        "parent_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 120
          },
          "maxItems": 20
        },
        "base_version": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "task_id",
        "sequence",
        "event_id",
        "kind",
        "sent_from",
        "send_to",
        "cause_by",
        "parent_ids",
        "base_version",
        "created_at",
        "payload"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "draft"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/Candidate"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "request"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/HelpRequest"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "contribution"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/Contribution"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "review"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/Review"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "lead_update"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/LeadUpdate"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "final"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/Final"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "runtime_error"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/RuntimeError"
              }
            }
          }
        }
      ]
    }
  }
}
