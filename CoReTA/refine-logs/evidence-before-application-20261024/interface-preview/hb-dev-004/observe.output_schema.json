              "enum": [
                "W1",
                "W1:artifact:L1",
                "W1:work_text:L1",
                "W2",
                "W2:artifact:L1",
                "W2:work_text:L1",
                "W3",
                "W3:artifact:L1",
                "W3:work_text:L1",
                "W4",
